# Quantum Superdense Coding Simulator - Environment Configuration Example
# Copy to .env.local for Next.js, or set in environment

# Frontend
NEXT_PUBLIC_APP_NAME="Quantum Superdense Coding Simulator"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Simulator Backend Service (FastAPI)
SIMULATOR_HOST="127.0.0.1"
SIMULATOR_PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
CORS_ALLOW_CREDENTIALS=true
MAX_SHOTS=100000
DEFAULT_SHOTS=1000
