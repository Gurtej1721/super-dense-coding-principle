{
  "name": "quantum-superdense-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/contracts && npm run build -w packages/quantum-core && npm run build -w apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:core": "vitest run --dir packages/quantum-core",
    "test:web": "vitest run --dir apps/web",
    "test:e2e": "playwright test",
    "lint": "next lint -d apps/web",
    "dev:web": "npm run dev -w apps/web",
    "dev": "npm run dev -w apps/web"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
